# Copy this file to .env and fill in what you need. .env is never committed to git.

# --- Language model ------------------------------------------------------------
# Option A (default): Claude through the Anthropic API. Fast on any laptop, needs internet,
# costs a little per answer. Get a key at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Option B: a local model with Ollama. Free and works with no internet, but needs a capable
# computer (about 8 GB+ free RAM; a GPU makes it much faster). Install Ollama, run
#   ollama pull llama3.2:3b
# then either leave ANTHROPIC_API_KEY empty, or set TRIX_LLM=ollama to prefer it even with a key.
# TRIX_LLM=            # claude | ollama | fallback  (empty = Claude if a key is set, else Ollama, else fallback)
# TRIX_MODEL=llama3.2:3b
# TRIX_CLAUDE_MODEL=claude-opus-5-5

# --- Optional live feeds ---------------------------------------------------------
# NASA_API_KEY=DEMO_KEY
# METEOMATICS_USER=
# METEOMATICS_PASSWORD=

# --- Server ------------------------------------------------------------------------
# TRIX_PORT=8000
